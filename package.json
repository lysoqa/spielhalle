{
  "name": "spielhalle",
  "productName": "Soqa Launcher",
  "version": "0.7.0",
  "description": "Pixel-Launcher für unsere Spiele",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.1.0",
    "@fontsource/silkscreen": "^5.1.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.soulgrind.spielhalle",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Soqa-Launcher-Setup-${version}.${ext}"
    }
  }
}
